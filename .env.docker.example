# Reference values for apps/backend/.env. Docker Compose loads that file directly.
DB_HOST=localhost
DB_PORT=1433
DB_USER=vagrok
DB_PASSWORD=replace-with-your-database-password
DB_NAME=orizzontdb
JWT_SECRET=replace-with-a-long-random-secret

# SMTP is optional for local UI testing. Configure real values to send mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=info@example.com