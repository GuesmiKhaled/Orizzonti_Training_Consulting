DB_HOST=localhost
DB_PORT=1433
DB_USER=vagrok
DB_PASSWORD=replace-with-your-database-password
DB_NAME=orizzontdb
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=info@orizzonti.tn
APP_PORT=5007
CORS_ORIGINS=http://localhost:8080

# Image uploads (optional). Defaults: ./uploads and the request's own origin.
# UPLOAD_DIR=/app/uploads
# UPLOAD_PUBLIC_URL=https://api.example.com

# Required. At least 32 random characters; the server will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Only used when the database has no admin account yet (at least 12 characters).
# The account must change this password at its first login.
# DEFAULT_ADMIN_PASSWORD=

# Set to true when the API runs behind a reverse proxy, so rate limits use the real client IP.
# TRUST_PROXY=true

# --- Cookie-based auth (audit finding #4) ---
# Separate secret for refresh tokens. Optional; falls back to JWT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REFRESH_TOKEN_SECRET=

# Set to "false" only for local HTTP dev; production must keep "true" (HTTPS).
# COOKIE_SECURE=true

# --- Database TLS (audit finding #2) ---
# Set DB_ENCRYPT=true to require an encrypted connection to SQL Server.
# DB_ENCRYPT=false
# Set DB_TRUST_SERVER_CERTIFICATE=false to enforce certificate validation.
# DB_TRUST_SERVER_CERTIFICATE=true

# --- Request limits (audit findings #6) ---
# JSON body size limit (default 1mb).
# BODY_SIZE_LIMIT=1mb
